// This file includes possible token kinds in a form suitable for usage via
// preprocessor. Include this header after defining the following macro:
//   #define KIND_ACTION(KD, STR, CAT) ...

// --- Keywords ---
#define KEYWORD_ACTION(KND,STR) KIND_ACTION(KND, STR, "keyword")
#include "keywords.def"
#undef KEYWORD_ACTION
// --- Identifiers/Number/Whitespace/Invalid (Ambiguous) ---
KIND_ACTION(TK_NONE, "", "")
KIND_ACTION(TK_IDENTIFIER, "", "identifier")
KIND_ACTION(TK_NUMBER, "", "constant")
KIND_ACTION(TK_CHARACTER, "'", "constant")
KIND_ACTION(TK_STRING, "\"", "string-literal")
// --- Comments ---
KIND_ACTION(TK_LINE_COMMENT, "//", "comment")
KIND_ACTION(TK_BLOCK_COMMENT, "/*", "comment")
// --- New Line ---
KIND_ACTION(TK_NEWLINE_SEQUENCE, "\r\n", "newline")
KIND_ACTION(TK_NEWLINE_R, "\r", "newline")
KIND_ACTION(TK_NEWLINE_N, "\n", "newline")
// --- Punctuators ---
KIND_ACTION(TK_LPAREN, "(", "punctuator")
KIND_ACTION(TK_RPAREN, ")", "punctuator")
KIND_ACTION(TK_LBRACE, "{", "punctuator")
KIND_ACTION(TK_RBRACE, "}", "punctuator")
KIND_ACTION(TK_DOT, ".", "punctuator")
KIND_ACTION(TK_ARROW, "->", "punctuator")
KIND_ACTION(TK_INC, "++", "punctuator")
KIND_ACTION(TK_DEC, "--", "punctuator")
KIND_ACTION(TK_AND, "&", "punctuator")
KIND_ACTION(TK_ASTERISK, "*", "punctuator")
KIND_ACTION(TK_PLUS, "+", "punctuator")
KIND_ACTION(TK_MINUS, "-", "punctuator")
KIND_ACTION(TK_TILDE, "~", "punctuator")
KIND_ACTION(TK_EXCLAMATION, "!", "punctuator")
KIND_ACTION(TK_DIV, "/", "punctuator")
KIND_ACTION(TK_MOD, "%", "punctuator")
KIND_ACTION(TK_LSHIFT, "<<", "punctuator")
KIND_ACTION(TK_RSHIFT, ">>", "punctuator")
KIND_ACTION(TK_LT, "<", "punctuator")
KIND_ACTION(TK_GT, ">", "punctuator")
KIND_ACTION(TK_LE, "<=", "punctuator")
KIND_ACTION(TK_GE, ">=", "punctuator")
KIND_ACTION(TK_EQ, "==", "punctuator")
KIND_ACTION(TK_NE, "!=", "punctuator")
KIND_ACTION(TK_XOR, "^", "punctuator")
KIND_ACTION(TK_OR, "|", "punctuator")
KIND_ACTION(TK_LOGICAL_AND, "&&", "punctuator")
KIND_ACTION(TK_LOGICAL_OR, "||", "punctuator")
KIND_ACTION(TK_QUESTION, "?", "punctuator")
KIND_ACTION(TK_COLON, ":", "punctuator")
KIND_ACTION(TK_SEMICOLON, ";", "punctuator")
KIND_ACTION(TK_ELLIPSIS, "...", "punctuator")
KIND_ACTION(TK_ASSIGN, "=", "punctuator")
KIND_ACTION(TK_MUL_ASSIGN, "*=", "punctuator")
KIND_ACTION(TK_DIV_ASSIGN, "/=", "punctuator")
KIND_ACTION(TK_MOD_ASSIGN, "%=", "punctuator")
KIND_ACTION(TK_PLUS_ASSIGN, "+=", "punctuator")
KIND_ACTION(TK_MINUS_ASSIGN, "-=", "punctuator")
KIND_ACTION(TK_LSHIFT_ASSIGN, "<<=", "punctuator")
KIND_ACTION(TK_RSHIFT_ASSIGN, ">>=", "punctuator")
KIND_ACTION(TK_AND_ASSIGN, "&=", "punctuator")
KIND_ACTION(TK_XOR_ASSIGN, "^=", "punctuator")
KIND_ACTION(TK_OR_ASSIGN, "|=", "punctuator")
KIND_ACTION(TK_COMMA, ",", "punctuator")
KIND_ACTION(TK_HASH, "#", "punctuator")
KIND_ACTION(TK_HASHHASH, "##", "punctuator")
KIND_ACTION(TK_LBRACKET, "[", "punctuator")
KIND_ACTION(TK_RBRACKET, "]", "punctuator")
KIND_ACTION(TK_LANGLE_BRACKET, "<:", "punctuator")
KIND_ACTION(TK_RANGLE_BRACKET, ":>", "punctuator")
KIND_ACTION(TK_LBRACE_ALT, "<%", "punctuator")
KIND_ACTION(TK_RBRACE_ALT, "%>", "punctuator")
KIND_ACTION(TK_HASH_ALT, "%:", "punctuator")
KIND_ACTION(TK_HASHHASH_ALT, "%:%:", "punctuator")

KIND_ACTION(TK_EOI, "", "end-of-input")	 // "eof"
